{
  "name": "claupe",
  "version": "0.0.1",
  "description": "A claude -p shim that drives a real claude TUI per invocation",
  "type": "module",
  "license": "MIT",
  "author": "nilbuild",
  "bin": {
    "claupe": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js",
    "dev": "tsx src/bin.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1"
  }
}
